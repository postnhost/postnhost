{
  "name": "postnhost",
  "private": true,
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --format=esm --outdir=app/assets/builds/postnhost --public-path=/assets",
    "build:css": "bundle exec rake css:build",
    "build:watch": "esbuild app/javascript/*.* --bundle --format=esm --outdir=app/assets/builds/postnhost --public-path=/assets --watch=forever",
    "build:css:watch": "bundle exec rake css:watch",
    "dev": "sh -c 'yarn build:watch & yarn build:css:watch & wait'"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.16",
    "@stimulus-components/dialog": "^1.0.1",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-code-block": "^3.30.5",
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-horizontal-rule": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-list": "^3.30.5",
    "@tiptap/extension-subscript": "^3.30.5",
    "@tiptap/extension-superscript": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-table-cell": "^3.30.5",
    "@tiptap/extension-table-header": "^3.30.5",
    "@tiptap/extension-table-row": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-underline": "^3.30.5",
    "@tiptap/extension-youtube": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "tailwindcss": "^4.1.12",
    "tiptap-extension-resize-image": "^1.4.6"
  },
  "packageManager": "yarn@1.22.22"
}
