<!DOCTYPE html>
<html lang="<%= content_for?(:lang) ? yield(:lang) : 'en' %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "postnhost" %></title>
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "postnhost" %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% if content_for?(:robots) %>
      <meta name="robots" content="<%= yield(:robots) %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag(*postnhost_stylesheet_assets, "data-turbo-track": "reload", media: "all") %>
    <%= javascript_include_tag "postnhost/application", "data-turbo-track": "reload", type: "module" %>

    <%= render "layouts/postnhost/favicon" %>

    <%= yield :head %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
