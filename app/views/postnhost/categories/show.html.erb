<% content_for :title, @category.name %>

<div class="space-y-8">
  <%= render 'postnhost/shared/elements/page_header',
    title: @category.name,
    description: @category.meta_description,
    stats: [
      { text: "Slug: /#{@category.slug}", class: '' },
      { text: "#{@pagy.count} articles", class: '' },
      { text: "Open", url: public_category_path(@category.slug), icon: 'external-link', target: '_blank' }
    ] do %>

    <%= render 'postnhost/shared/elements/button_link',
      text: 'Back to Categories',
      url: categories_path(@article),
      variant: :secondary,
      icon: 'chevron-left',
      extra_class: 'w-full md:w-auto' %>

    <%= render 'postnhost/shared/elements/button_link',
      text: 'Translations',
      url: category_variants_path(@category),
      icon: 'language',
      extra_class: 'w-full md:w-auto' %>

    <%= render 'postnhost/shared/elements/button_link',
      text: 'Edit',
      url: edit_category_path(@category),
      icon: 'edit',
      extra_class: 'w-full md:w-auto' %>

    <%= render 'postnhost/shared/elements/button_link',
      text: 'Delete',
      url: category_path(@category),
      variant: :danger,
      icon: 'trash',
      extra_class: 'w-full md:w-auto',
      data: {
        turbo_method: :delete,
        turbo_confirm: "Are you sure you want to delete this category? This action cannot be undone."
      } %>
  <% end %>

  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-medium text-gray-900">Articles</h2>
          <p class="mt-1 text-sm text-gray-600">Articles in this category</p>
        </div>

        <span class="<%= stats_badge_classes(variant: :gray) %>">
          <%= @pagy.count %> articles
        </span>
      </div>
    </div>

    <% if @articles.any? %>
      <div class="divide-y divide-gray-200">
        <% @articles.each do |article| %>
          <div class="<%= table_row_classes %>">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <%= link_to edit_article_path(article), class: "block group" do %>
                  <div class="font-medium text-gray-900 group-hover:text-gray-600 transition-colors">
                    <%= article.title.present? ? article.title : 'Untitled' %>
                  </div>
                  <div class="text-sm text-gray-500 mt-1 flex items-center space-x-4">
                    <% if article.language %>
                      <span><%= article.language.name %></span>
                    <% end %>
                    <span><%= article.created_at.strftime('%b %d, %Y') %></span>
                  </div>
                <% end %>
              </div>

              <div class="flex items-center space-x-2">
                <span class="<%= stats_badge_classes(variant: article.published? ? :green : :gray) %>">
                  <%= article.published? ? 'Published' : 'Draft' %>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="border-t border-gray-200 px-6 py-4">
          <%== pagination_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <%= render 'postnhost/shared/elements/empty_state',
        icon: 'document-text',
        title: 'No articles',
        description: 'No articles have been created in this category yet.' %>
    <% end %>
  </div>
</div>
