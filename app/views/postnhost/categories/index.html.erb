<% content_for :title, "Categories" %>

<div class="space-y-8">
  <%= render 'postnhost/shared/elements/page_header',
    title: 'Categories',
    description: 'Manage your article categories and their translations' do %>
    <%= render 'postnhost/shared/elements/button_link',
      text: 'New Category',
      url: new_category_path,
      icon: 'plus',
      extra_class: 'w-full md:w-auto' %>
  <% end %>

  <% if @categories.any? %>
    <%= render 'postnhost/shared/elements/table_container',
      headers: [
        { text: 'Category', class: 'col-span-6' },
        { text: 'Articles', class: 'col-span-3' },
        { text: 'Actions', class: 'col-span-3 text-right' }
      ] do %>
      <% @categories.each do |category| %>
        <div class="<%= table_row_classes %>">
          <div class="grid grid-cols-12 gap-4 items-center">
            <div class="col-span-6">
              <%= link_to category_path(category), class: "block group" do %>
                <div class="font-medium text-gray-900 group-hover:text-gray-600 transition-colors">
                  <%= category.name %>
                </div>
                <% if category.slug.present? %>
                  <div class="text-sm text-gray-500 mt-1">
                    /<%= category.slug %>
                  </div>
                <% end %>
              <% end %>
            </div>

            <div class="col-span-3">
              <span class="<%= stats_badge_classes(variant: :blue) %>">
                <%= category.articles_count %>
              </span>
            </div>

            <div class="col-span-3 flex items-center justify-end space-x-2">
              <%= render 'postnhost/shared/elements/icon_button',
                icon: 'eye',
                url: category_path(category) %>

              <%= render 'postnhost/shared/elements/icon_button',
                icon: 'edit',
                url: edit_category_path(category) %>

              <%= render 'postnhost/shared/elements/icon_button',
                icon: 'trash',
                url: category_path(category),
                variant: :danger,
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this category? This action cannot be undone."
                } %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <%= render 'postnhost/shared/elements/empty_state',
      icon: 'folder',
      title: 'No categories',
      description: 'Get started by creating your first category.' do %>
      <%= render 'postnhost/shared/elements/button_link',
        text: 'New Category',
        url: new_category_path,
        icon: 'plus' %>
    <% end %>
  <% end %>

  <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
    Categories appear in the footer between the list of the articles and a footer links if there are at least one published article in the category.
  </div>
</div>
