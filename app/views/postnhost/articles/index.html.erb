<% content_for :title, "Articles" %>

<div class="space-y-6">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <nav aria-label="Filter by status" class="flex w-full gap-0.5 overflow-x-auto rounded-lg bg-gray-100 p-0.5 sm:w-auto">
      <% [
        ["All", nil],
        ["Published", "published"],
        ["Draft", "draft"],
        ["Scheduled", "scheduled"]
      ].each do |label, status| %>
        <%= link_to label,
          articles_path(status:, sort: @sort),
          class: [
            "shrink-0 rounded-md px-2.5 py-1 text-xs font-medium cursor-pointer",
            @status == status ? "bg-white text-gray-900 shadow-sm" : "text-gray-600 hover:text-gray-900"
          ].join(" ") %>
      <% end %>
    </nav>

    <%= form_with url: articles_path, method: :get, class: "w-full sm:w-auto" do %>
      <%= hidden_field_tag :status, @status if @status.present? %>
      <label for="articles-sort" class="sr-only">Sort</label>
      <div class="relative rounded-lg bg-gray-100 p-0.5">
        <%= select_tag :sort,
          options_for_select(
            [
              ["Newest", "created_at_desc"],
              ["Oldest", "created_at_asc"]
            ],
            @sort
          ),
          id: "articles-sort",
          class: "w-full appearance-none rounded-md bg-transparent py-1 pl-2.5 pr-7 text-xs font-medium text-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-900 cursor-pointer sm:w-auto",
          onchange: "this.form.requestSubmit()" %>
        <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2">
          <%= icon("chevron-down", css_class: "h-3.5 w-3.5 text-gray-500") %>
        </span>
      </div>
    <% end %>
  </div>

  <% if @articles.any? %>
    <div class="grid grid-cols-1 gap-6">
      <% @articles.each do |article| %>
        <div class="bg-white rounded-2xl border border-gray-200 p-6 hover:border-gray-300 transition-colors duration-200">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center space-x-3 mb-2">
                <span class="<%= stats_badge_classes(variant: article.published? ? :green : :gray) %>">
                  <%= article.published? ? 'Published' : 'Draft' %>
                </span>
                <% if article.scheduled_at.present? && !article.published? %>
                  <span class="<%= stats_badge_classes(variant: :blue) %>" title="Scheduled for <%= admin_datetime(article.scheduled_at, format: '%b %d, %Y at %H:%M %Z') %>">
                    Scheduled
                  </span>
                  <span class="hidden md:inline-flex text-sm text-gray-500">
                    <%= admin_datetime(article.scheduled_at, format: '%b %d, %Y at %H:%M %Z') %>
                  </span>
                <% end %>
                <% if article.categories.loaded? && article.categories.any? %>
                  <span class="hidden md:inline-flex text-sm text-gray-500"><%= article.categories.first.name %></span>
                <% end %>
                <span class="text-sm text-gray-500"><%= article.language&.name %></span>
                <% if article.article_variants_count > 0 %>
                  <span class="hidden md:inline-flex <%= stats_badge_classes(variant: :gray) %>">
                    + <%= article.article_variants_count %>
                  </span>
                <% end %>
              </div>

              <%= link_to edit_article_path(article), class: "block group" do %>
                <h3 class="text-lg font-semibold text-gray-900 group-hover:text-gray-700 mb-2">
                  <%= article.title.presence || "Untitled Article" %>
                </h3>
                <% if article_excerpt(article).present? %>
                  <p class="text-sm text-gray-600 mb-3">
                    <%= article_excerpt(article) %>
                  </p>
                <% end %>
              <% end %>

              <div class="text-xs text-gray-500">
                Updated <%= time_ago_in_words(article.updated_at) %> ago
              </div>
            </div>

            <div class="flex items-center space-x-2 ml-6">
              <%= link_to edit_article_path(article), class: "p-2 #{icon_button_classes}" do %>
                <%= icon("edit", css_class: "w-4 h-4") %>
              <% end %>
              <%= button_to article, method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this article? This action cannot be undone." },
                  class: "p-2 #{icon_button_classes(variant: :danger)} cursor-pointer" do %>
                <%= icon("trash", css_class: "w-4 h-4") %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-8 flex justify-center">
        <%== pagination_nav(@pagy) %>
      </div>
    <% end %>
  <% elsif @status.present? %>
    <%= render 'postnhost/shared/elements/empty_state',
      icon: 'document-text',
      title: 'No matching articles',
      description: 'Try a different status filter, or clear filters to see all articles.' do %>
      <%= render 'postnhost/shared/elements/button_link',
        text: 'Clear filters',
        url: articles_path(sort: @sort),
        variant: :secondary,
        extra_class: 'rounded-xl' %>
    <% end %>
  <% else %>
    <%= render 'postnhost/shared/elements/empty_state',
      icon: 'document-text',
      title: 'No articles yet',
      description: 'Get started by creating your first article.' do %>
      <%= render 'postnhost/shared/elements/button_link',
        text: 'Create Article',
        url: new_article_path,
        icon: 'plus',
        extra_class: 'rounded-xl',
        data: { turbo_prefetch: false } %>
    <% end %>
  <% end %>
</div>
