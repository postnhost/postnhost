<div data-controller="suggestion-manager">
  <%= hidden_field_tag "#{form.object_name}[suggested_article_ids][]", "" %>
  <!-- Current Suggestions -->
  <div data-suggestion-manager-target="suggestionList" class="space-y-2 mb-3">
    <% article.suggested_articles.each do |suggested| %>
      <div class="flex items-center justify-between bg-gray-50 px-3 py-2 rounded-xl" data-suggestion-id="<%= suggested.id %>">
        <span class="text-sm text-gray-900 truncate" data-suggestion-name><%= suggested.title %></span>
        <button type="button" class="text-gray-400 hover:text-red-600 transition-colors cursor-pointer flex-shrink-0 ml-2" data-action="click->suggestion-manager#removeSuggestion">
          <%= icon("close", css_class: "w-4 h-4") %>
        </button>
        <%= form.hidden_field :suggested_article_ids, value: suggested.id, multiple: true %>
      </div>
    <% end %>
  </div>

  <!-- Add Suggestion Button -->
  <button type="button" data-suggestion-manager-target="addButton" data-action="click->suggestion-manager#showSelector" class="w-full text-left px-3 py-2 border border-dashed border-gray-300 rounded-xl text-sm text-gray-500 hover:border-gray-400 hover:text-gray-700 transition-colors cursor-pointer">
    + Add suggestion
  </button>

  <!-- Suggestion Selector (Hidden by default) -->
  <div data-suggestion-manager-target="selector" class="hidden mt-2">
    <select data-action="change->suggestion-manager#addSuggestion" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm bg-white">
      <option value="">Select an article to suggest...</option>
      <% articles.each do |a| %>
        <% next if a.id == article.id %>
        <option value="<%= a.id %>"><%= a.title %></option>
      <% end %>
    </select>
    <button type="button" data-action="click->suggestion-manager#hideSelector" class="mt-2 text-xs text-gray-500 hover:text-gray-700 cursor-pointer">Cancel</button>
  </div>

  <!-- Template for new suggestion items -->
  <template data-suggestion-manager-target="template">
    <div class="flex items-center justify-between bg-gray-50 px-3 py-2 rounded-xl" data-suggestion-id="">
      <span class="text-sm text-gray-900 truncate" data-suggestion-name></span>
      <button type="button" class="text-gray-400 hover:text-red-600 transition-colors cursor-pointer flex-shrink-0 ml-2" data-action="click->suggestion-manager#removeSuggestion">
        <%= icon("close", css_class: "w-4 h-4") %>
      </button>
      <%= form.hidden_field :suggested_article_ids, value: "", multiple: true %>
    </div>
  </template>
</div>
