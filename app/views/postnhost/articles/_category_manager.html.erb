<div data-controller="category-manager">
  <%= hidden_field_tag "#{form.object_name}[category_ids][]", "" %>
  <!-- Current Categories -->
  <div data-category-manager-target="categoryList" class="space-y-2 mb-3">
    <% article.categories.each do |category| %>
      <div class="flex items-center justify-between bg-gray-50 px-3 py-2 rounded-xl" data-category-id="<%= category.id %>">
        <span class="text-sm text-gray-900" data-category-name><%= category.name %></span>
        <button type="button" class="text-gray-400 hover:text-red-600 transition-colors cursor-pointer" data-action="click->category-manager#removeCategory">
          <%= icon("close", css_class: "w-4 h-4") %>
        </button>
        <%= form.hidden_field :category_ids, value: category.id, multiple: true %>
      </div>
    <% end %>
  </div>

  <!-- Add Category Button -->
  <button type="button" data-category-manager-target="addButton" data-action="click->category-manager#showSelector" class="w-full text-left px-3 py-2 border border-dashed border-gray-300 rounded-xl text-sm text-gray-500 hover:border-gray-400 hover:text-gray-700 transition-colors cursor-pointer">
    + Add category
  </button>

  <!-- Category Selector (Hidden by default) -->
  <div data-category-manager-target="selector" class="hidden mt-2">
    <select data-action="change->category-manager#addCategory" class="w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm bg-white">
      <option value="">Select a category to add...</option>
      <% categories.each do |category| %>
        <option value="<%= category.id %>"><%= category.name %></option>
      <% end %>
    </select>
    <button type="button" data-action="click->category-manager#hideSelector" class="mt-2 text-xs text-gray-500 hover:text-gray-700 cursor-pointer">Cancel</button>
  </div>

  <!-- Template for new category items -->
  <template data-category-manager-target="template">
    <div class="flex items-center justify-between bg-gray-50 px-3 py-2 rounded-xl" data-category-id="">
      <span class="text-sm text-gray-900" data-category-name></span>
      <button type="button" class="text-gray-400 hover:text-red-600 transition-colors cursor-pointer" data-action="click->category-manager#removeCategory">
        <%= icon("close", css_class: "w-4 h-4") %>
      </button>
      <%= form.hidden_field :category_ids, value: "", multiple: true %>
    </div>
  </template>
</div>
