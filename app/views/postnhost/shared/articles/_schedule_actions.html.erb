<div class="space-y-3" data-controller="schedule-manager">
  <button
    type="button"
    data-schedule-manager-target="addButton"
    data-action="click->schedule-manager#showSelector"
    class="<%= editor_button_classes %>">
    <div class="flex items-center justify-center space-x-2">
      <%= icon("schedule", css_class: "w-4 h-4") %>
      <span>Schedule</span>
    </div>
  </button>

  <% if resource.scheduled_at.present? %>
    <div data-schedule-manager-target="scheduledSummary" class="bg-blue-50 border border-blue-100 rounded-xl px-3 py-2 text-sm text-blue-900">
      <div class="flex items-start justify-between">
        <div class="flex items-start space-x-2">
          <%= icon("schedule", css_class: "w-4 h-4 mt-0.5 text-blue-700") %>
          <div>
            <p class="font-medium">Scheduled publish</p>
            <p class="text-blue-700 text-xs mt-1"><%= admin_datetime(resource.scheduled_at) %></p>
          </div>
        </div>
      </div>
      <div class="mt-2 flex items-center justify-center space-x-4">
        <button type="button" data-action="click->schedule-manager#showSelector" class="text-xs text-blue-700 hover:text-blue-900 cursor-pointer">
          Update
        </button>
        <button type="button" data-action="click->schedule-manager#clearSchedule" class="text-xs text-blue-700 hover:text-blue-900 cursor-pointer">
          Cancel
        </button>
      </div>
    </div>
  <% end %>

  <div data-schedule-manager-target="selector" class="hidden">
    <% if local_assigns[:form].present? %>
      <%= form.datetime_local_field :scheduled_at,
          min: admin_datetime_local_value(Time.current),
          data: { schedule_manager_target: "input", action: "change->schedule-manager#markChanged blur->schedule-manager#markChanged" },
          class: "w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm bg-white" %>
    <% else %>
      <%= datetime_local_field_tag "article[scheduled_at]",
          admin_datetime_local_value(resource.scheduled_at),
          id: "article_scheduled_at",
          min: admin_datetime_local_value(Time.current),
          data: { schedule_manager_target: "input", action: "change->schedule-manager#markChanged blur->schedule-manager#markChanged" },
          class: "w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm bg-white" %>
    <% end %>
    <button type="button" data-action="click->schedule-manager#hideSelector" class="mt-2 text-xs text-gray-500 hover:text-gray-700 cursor-pointer">Cancel</button>
  </div>
</div>
