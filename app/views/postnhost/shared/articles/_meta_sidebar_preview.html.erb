<div class="w-1/5 bg-white border border-gray-200 p-6 hidden md:block border-t-0 sticky top-0 self-start min-h-screen">
  <div class="space-y-6">
    <div>
      <label class="block text-sm font-medium text-gray-900 mb-2">Title Tag</label>
      <div class="w-full px-3 py-2 border border-gray-200 rounded-xl bg-gray-50 text-sm text-gray-700">
        <%= resource.title_tag.presence || resource.title %>
      </div>
      <p class="mt-2 text-xs text-gray-500">Fallbacks to article title if empty.</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-900 mb-2">Meta Description</label>
      <div class="w-full px-3 py-2 border border-gray-200 rounded-xl bg-gray-50 text-sm text-gray-700 min-h-[72px]">
        <%= resource.meta_description %>
      </div>
      <p class="mt-2 text-xs text-gray-500">Recommended: 150-160 characters</p>
    </div>

    <div class="pt-4 border-t border-gray-100">
      <div class="text-sm text-gray-600 space-y-1">
        <p><strong>Created:</strong> <%= admin_datetime(resource.created_at) %></p>
        <p><strong>Updated:</strong> <%= admin_datetime(resource.updated_at) %></p>
        <% if resource.article_snapshot.present? %>
          <p><strong>Published:</strong> <%= admin_datetime(resource.article_snapshot.published_at) %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
