<%
  # Form page header partial for new/edit pages
  #
  # Parameters:
  #   title: (required) Page title
  #   description: (required) Page description
  #   actions block: Action buttons (optional)
%>

<div class="mb-8 flex flex-col md:flex-row md:items-start md:justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold text-gray-900"><%= title %></h1>
    <p class="mt-2 text-gray-600"><%= description %></p>
  </div>

  <% if block_given? %>
    <div class="flex flex-col space-y-3 md:flex-row md:items-center md:space-y-0 md:space-x-3 w-full md:w-auto shrink-0">
      <%= yield %>
    </div>
  <% end %>
</div>
