<% if resource.errors.any? %>
  <div id="error_explanation" class="bg-red-50 border border-red-200 text-red-800 px-5 py-4 rounded-2xl mb-6 font-medium" data-turbo-temporary>
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <%= icon("alert-circle", css_class: "h-5 w-5 text-red-600 mt-0.5") %>
      </div>
      <div class="ml-3 flex-1">
        <h3 class="text-sm font-semibold text-red-800 mb-2">
          <%= pluralize(resource.errors.count, "error") %> prohibited this from being saved:
        </h3>
        <ul class="text-sm space-y-1">
          <% resource.errors.full_messages.each do |message| %>
            <li class="flex items-start">
              <span class="inline-block w-1.5 h-1.5 bg-red-400 rounded-full mt-2 mr-2 flex-shrink-0"></span>
              <%= message %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>
