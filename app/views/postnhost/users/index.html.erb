<% content_for :title, "Authors" %>

<div class="space-y-8">
  <%= render "postnhost/shared/elements/page_header",
    title: "Authors",
    description: "Manage author accounts and profile details for article attribution" do %>
    <%= render "postnhost/shared/elements/button_link",
      text: "New Author",
      url: new_user_path,
      icon: "plus",
      extra_class: "w-full md:w-auto" %>
  <% end %>

  <% if @users.any? %>
    <%= render "postnhost/shared/elements/table_container",
      headers: [
        { text: "Author", class: "col-span-7" },
        { text: "Slug", class: "hidden md:block md:col-span-3" },
        { text: "Actions", class: "col-span-2 text-right" }
      ] do %>
      <% @users.each do |user| %>
        <div class="<%= table_row_classes %>">
          <div class="grid grid-cols-12 gap-4 items-center">
            <div class="col-span-10 md:col-span-7">
              <%= link_to edit_user_path(user), class: "block group" do %>
                <div class="flex items-center gap-3">
                  <%= render "postnhost/users/avatar",
                    user: user,
                    size_class: "w-10 h-10 min-w-10 min-h-10",
                    text_size_class: "text-sm",
                    mobile_visibility_class: "hidden md:flex" %>
                  <div>
                    <div class="font-medium text-gray-900 group-hover:text-gray-600 transition-colors">
                      <%= user.name %>
                    </div>
                    <div class="text-sm text-gray-500 mt-0.5"><%= user.email %></div>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="hidden md:block md:col-span-3">
              <% if author_pages_enabled? %>
                <%= link_to public_author_path(user.slug),
                  class: "text-sm text-gray-600 hover:text-gray-900 transition-colors inline-flex items-center gap-1 cursor-pointer",
                  target: "_blank",
                  rel: "noopener" do %>
                  <span>/authors/<%= user.slug %></span>
                  <%= icon("external-link", css_class: "w-3.5 h-3.5") %>
                <% end %>
              <% else %>
                <span class="text-sm text-gray-500"><%= user.slug %></span>
              <% end %>
            </div>

            <div class="col-span-2 flex items-center justify-end space-x-2">
              <%= render "postnhost/shared/elements/icon_button",
                icon: "edit",
                url: edit_user_path(user) %>

              <% unless user == current_user %>
                <%= render "postnhost/shared/elements/icon_button",
                  icon: "trash",
                  url: user_path(user),
                  variant: :danger,
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure you want to remove this author? Their articles will be kept. Authors who own pages cannot be removed."
                  } %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <%= render "postnhost/shared/elements/empty_state",
      icon: "users",
      title: "No authors",
      description: "Create your first author profile to start assigning article bylines." do %>
      <%= render "postnhost/shared/elements/button_link",
        text: "New Author",
        url: new_user_path,
        icon: "plus" %>
    <% end %>
  <% end %>

  <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
    Authors can be assigned to articles from the editor sidebar. You can add multiple authors per article.
  </div>
</div>
