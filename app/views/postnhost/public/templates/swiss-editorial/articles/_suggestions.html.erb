<% cache [public_site_revision, @article, @actual_language, "swiss-editorial_suggestions"] do %>
<% if @article.suggestions_for(language: @actual_language).any? %>
  <section class="mx-auto max-w-[1440px] px-6 pt-24">
    <div class="mb-8 flex items-baseline justify-between border-b-2 border-[#0a0a0a] pb-4">
      <h2 class="text-[40px] font-bold leading-none"><%= t("postnhost.public.blog.read_more") %></h2>
    </div>

    <div class="grid grid-cols-1 gap-x-6 gap-y-12 md:grid-cols-3">
      <% @article.suggestions_for(language: @actual_language).each_with_index do |suggestion, index| %>
        <% cache [public_site_revision, suggestion, article_authors_cache_key(suggestion), "swiss-editorial_suggestion_card"] do %>
          <article class="flex flex-col gap-3 break-words">
            <% if suggestion.cover_image? %>
              <%= link_to public_article_path(suggestion.slug), class: "block cursor-pointer", "aria-label": t("postnhost.public.blog.read_article_aria_label", title: suggestion.title) do %>
                <%= render "postnhost/public/templates/swiss-editorial/shared/thumbnail_cover_image", publication: suggestion, index: index %>
              <% end %>
            <% end %>

            <% if suggestion.categories.any? %>
              <%= link_to "— #{localized_category_name(suggestion.categories.first, @current_language)}",
                    language_category_path(suggestion.categories.first.slug, @current_language),
                    class: "text-[11px] font-semibold uppercase text-[#d4322c] hover:text-[#a4221d] cursor-pointer" %>
            <% end %>

            <%= link_to public_article_path(suggestion.slug), class: "group block cursor-pointer" do %>
              <h3 class="text-[22px] font-semibold leading-tight text-[#0a0a0a] group-hover:text-[#d4322c]">
                <%= suggestion.title %>
              </h3>
            <% end %>

            <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] font-medium uppercase text-[#6b6b6b]">
              <% if article_authors(suggestion).any? %>
                <span><%= author_name(article_authors(suggestion).first) %></span>
              <% end %>
              <span><%= l suggestion.published_at.to_date, format: :long %></span>
            </div>
          </article>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
<% end %>
