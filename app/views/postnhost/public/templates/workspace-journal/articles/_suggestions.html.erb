<% cache [public_site_revision, @article, @actual_language, "workspace-journal_suggestions"] do %>
<% if @article.suggestions_for(language: @actual_language).any? %>
  <section class="mx-auto max-w-[1800px] px-6 pt-10 lg:px-10 lg:pt-12">
    <div class="grid grid-cols-1 gap-8 lg:gap-12 xl:grid-cols-[minmax(0,1fr)_minmax(0,820px)_minmax(0,1fr)]">
      <div class="lg:mx-auto lg:w-full lg:max-w-[820px] xl:col-start-2 xl:mx-0 xl:max-w-none">
        <div class="mb-6 border-b border-[#eeeeec] pb-4 lg:mb-8">
          <h2 class="text-lg/6 font-semibold text-[#1f1f1f]"><%= t("postnhost.public.blog.read_more") %></h2>
        </div>

        <div class="grid grid-cols-1 gap-x-10 gap-y-10 md:grid-cols-2">
          <% @article.suggestions_for(language: @actual_language).each_with_index do |suggestion, index| %>
            <% cache [public_site_revision, suggestion, article_authors_cache_key(suggestion), "workspace-journal_suggestion_card"] do %>
              <article class="group break-words">
                <% if suggestion.cover_image? %>
                  <%= link_to public_article_path(suggestion.slug), class: "mb-5 block cursor-pointer", "aria-label": t("postnhost.public.blog.read_article_aria_label", title: suggestion.title) do %>
                    <%= render "postnhost/public/templates/workspace-journal/shared/thumbnail_cover_image",
                          publication: suggestion,
                          index: index,
                          image_class: "aspect-[16/9] w-full rounded-md border border-[#e8e6e1] bg-[#f7f6f3] object-cover" %>
                  <% end %>
                <% end %>

                <% if suggestion.categories.any? %>
                  <%= link_to localized_category_name(suggestion.categories.first, @current_language),
                        language_category_path(suggestion.categories.first.slug, @current_language),
                        class: "text-sm/6 font-medium text-[#85827d] hover:text-[#1f1f1f] cursor-pointer" %>
                <% end %>

                <%= link_to public_article_path(suggestion.slug), class: "mt-2 block cursor-pointer", "aria-label": t("postnhost.public.blog.read_article_aria_label", title: suggestion.title) do %>
                  <h3 class="text-lg/6 font-semibold text-[#1f1f1f] group-hover:text-[#5f5d59]">
                    <%= suggestion.title %>
                  </h3>
                <% end %>

                <p class="mt-3 text-sm/6 text-[#85827d]">
                  <% if article_authors(suggestion).any? %>
                    <%= author_name(article_authors(suggestion).first) %> /
                  <% end %>
                  <%= l suggestion.published_at.to_date, format: :long %>
                </p>
              </article>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>
<% end %>
