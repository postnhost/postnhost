<%= render "postnhost/public/articles/content_for/index" %>

<% if public_search_endpoint? %>
  <section class="mx-auto max-w-[1180px] px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <%= render "postnhost/public/templates/workspace-journal/articles/search_form" %>
  </section>

  <% if category_articles.any? %>
    <section class="mx-auto max-w-[1800px] px-6 lg:px-10">
      <div class="grid grid-cols-1 gap-x-12 gap-y-10 md:grid-cols-2 lg:gap-y-14 xl:grid-cols-3">
        <%= render partial: "postnhost/public/templates/workspace-journal/articles/article_card",
              collection: category_articles,
              as: :item,
              cached: ->(item) { [public_site_revision, item, article_authors_cache_key(item), "workspace-journal_search_card"] } %>
      </div>

      <div class="pt-8 lg:pt-10">
        <%= render "postnhost/public/templates/workspace-journal/shared/pagination", pagy: @pagy %>
      </div>
    </section>
  <% else %>
    <section class="mx-auto max-w-[1180px] px-4 pb-12 text-center sm:px-6 lg:px-8 lg:pb-16">
      <div class="border-y border-zinc-950/10 py-10 lg:py-12">
        <h2 class="text-2xl/8 font-semibold text-zinc-950"><%= t("postnhost.public.blog.no_articles") %></h2>
        <p class="mt-3 text-sm/6 text-zinc-600"><%= t("postnhost.public.blog.no_articles_description") %></p>
      </div>
    </section>
  <% end %>
<% elsif category_articles.any? %>
  <section class="mx-auto max-w-[1800px] px-6 pb-8 pt-10 lg:px-10 lg:pb-10 lg:pt-12">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[300px_minmax(0,1fr)]">
      <aside class="lg:sticky lg:top-28 lg:self-start lg:border-r lg:border-[#eeeeec] lg:pb-16 lg:pr-16">
        <h1 class="break-words text-[2.5rem] font-semibold leading-none text-[#111111] sm:text-[3rem] lg:text-[2.875rem]">
          <%= public_blog_heading %>
        </h1>

        <% if show_public_blog_subtitle? %>
          <p class="mt-4 max-w-[18rem] text-sm/6 text-[#77736e] lg:mt-6">
            <%= t("postnhost.public.site.blog_subtitle") %>
          </p>
        <% end %>

        <%= render "postnhost/public/templates/workspace-journal/shared/category_navigation" %>
      </aside>

      <div class="min-w-0">
        <%= render "postnhost/public/templates/workspace-journal/articles/top_picks" %>

        <div class="grid grid-cols-1 gap-x-16 gap-y-10 md:grid-cols-2 lg:gap-y-14">
          <%= render partial: "postnhost/public/templates/workspace-journal/articles/article_card",
                collection: category_articles,
                as: :item,
                cached: ->(item) { [public_site_revision, item, article_authors_cache_key(item), "workspace-journal_index_card"] } %>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-[1800px] px-6 pt-8 lg:px-10 lg:pt-10">
    <%= render "postnhost/public/templates/workspace-journal/shared/pagination", pagy: @pagy %>
  </div>
<% else %>
  <section class="mx-auto max-w-[1180px] px-4 py-12 text-center sm:px-6 lg:px-8 lg:py-16">
    <div class="border-y border-zinc-950/10 py-10 lg:py-12">
      <h1 class="text-2xl/8 font-semibold text-zinc-950"><%= t("postnhost.public.blog.no_articles") %></h1>
      <p class="mt-3 text-sm/6 text-zinc-600"><%= t("postnhost.public.blog.no_articles_description") %></p>
    </div>
  </section>
<% end %>
