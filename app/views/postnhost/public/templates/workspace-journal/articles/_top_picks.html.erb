<% if top_pick_articles.any? && !public_search_endpoint? && !public_search_page? && !paginated_public_page? %>
  <section class="mb-12 border-b border-[#eeeeec] pb-8 lg:mb-14 lg:pb-10">
    <div class="mb-6 lg:mb-8">
      <h2 class="text-lg/6 font-semibold text-[#1f1f1f]"><%= t("postnhost.public.blog.top_picks") %></h2>
    </div>

    <div class="grid grid-cols-1 gap-x-16 gap-y-10 md:grid-cols-2">
      <% top_pick_articles.each_with_index do |item, index| %>
        <% cache [public_site_revision, item, article_authors_cache_key(item), "workspace-journal_top_pick"] do %>
          <article class="break-words">
            <% if category_article(item).categories.any? %>
              <p class="mb-1 text-sm/6 font-medium text-[#85827d]">
                <%= localized_category_name(category_article(item).categories.first, @current_language) %>
              </p>
            <% end %>

            <%= link_to category_article_url(item), class: "group block cursor-pointer", "aria-label": t("postnhost.public.blog.read_article_aria_label", title: item.title) do %>
              <h3 class="text-lg/6 font-semibold text-[#1f1f1f] group-hover:text-[#5f5d59]">
                <%= item.title %>
              </h3>
            <% end %>

            <p class="mt-3 text-sm/6 text-[#85827d]">
              <% if author_name(category_article_author_user(item)).present? %>
                <%= author_name(category_article_author_user(item)) %> /
              <% end %>
              <%= l category_article(item).published_at.to_date, format: :long %>
            </p>
          </article>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
