<% if publication.cover_image? %>
  <%= image_tag publication.cover_image.thumbnail.url,
        loading: index.to_i < 3 ? "eager" : "lazy",
        fetchpriority: index.to_i < 3 ? "high" : "auto",
        alt: publication.cover_image_alt.presence || publication.title,
        width: 520,
        height: 325,
        class: local_assigns.fetch(:image_class, "aspect-[16/10] w-full rounded-md bg-zinc-100 object-cover") %>
<% end %>
