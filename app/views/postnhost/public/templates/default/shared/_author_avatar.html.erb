<div class="<%= size_class %> bg-gray-100 rounded-full flex items-center justify-center overflow-hidden">
  <% if author_avatar(user).present? %>
    <%= image_tag author_avatar(user), class: "w-full h-full object-cover", alt: "Author Image" %>
  <% elsif author_initials(user).present? %>
    <span class="<%= text_size_class %> font-medium text-gray-600">
      <%= author_initials(user) %>
    </span>
  <% end %>
</div>
