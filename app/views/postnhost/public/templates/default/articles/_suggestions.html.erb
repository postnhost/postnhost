<% cache [public_site_revision, @article, @actual_language, "default_suggestions"] do %>
<% if @article.suggestions_for(language: @actual_language).any? %>
  <div class="bg-white border-t border-gray-200 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-8"><%= t('postnhost.public.blog.read_more') %></h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @article.suggestions_for(language: @actual_language).each_with_index do |suggestion, index| %>
          <% cache [public_site_revision, suggestion, article_authors_cache_key(suggestion), "default_suggestion"] do %>
            <article class="bg-white rounded-2xl border border-gray-200 hover:border-gray-300 transition-all duration-200 overflow-hidden flex flex-col break-words">
              <%= link_to public_article_path(suggestion.slug), class: "block", "aria-label": t('postnhost.public.blog.read_article_aria_label', title: suggestion.title) do %>
                <%= render "postnhost/public/templates/default/shared/thumbnail_cover_image", publication: suggestion, index: index %>
              <% end %>

              <div class="p-8 flex-1 flex flex-col">
                <div class="flex items-center space-x-3 mb-4">
                  <% if suggestion.categories.any? %>
                    <%= link_to localized_category_name(suggestion.categories.first, @current_language), language_category_path(suggestion.categories.first.slug, @current_language),
                            class: 'inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-800 hover:bg-gray-200 transition-colors' %>
                  <% end %>
                  <span class="text-sm text-gray-500">
                    <%= l suggestion.published_at.to_date, format: :long %>
                  </span>
                </div>

                <%= link_to public_article_path(suggestion.slug), class: "block group flex-1" do %>
                  <h2 class="text-xl font-semibold text-gray-900 group-hover:text-gray-700 mb-3 line-clamp-2">
                    <%= suggestion.title %>
                  </h2>
                  <% if article_excerpt(suggestion).present? %>
                    <p class="text-gray-600 mb-4 line-clamp-3">
                      <%= article_excerpt(suggestion) %>
                    </p>
                  <% end %>
                <% end %>
              </div>
            </article>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<% end %>
