<% content_for :title, @content.title_tag.present? ? @content.title_tag : @content.title %>
<% content_for :og_title, @content.og_title if @content.og_title.present? %>
<% content_for :schema_headline, @content.schema_headline if @content.schema_headline.present? %>
<% if @content.use_excerpt_as_meta_description? && article_excerpt(@content).present? %>
  <% content_for :meta_description, article_excerpt(@content) %>
<% elsif @content.meta_description.present? %>
  <% content_for :meta_description, @content.meta_description %>
<% end %>
<% content_for :lang, @actual_language.html_lang %>
<% content_for :url, params[:locale].present? ? localized_public_article_url(@actual_language.html_lang, @article.slug) : public_article_url(@article.slug) %>

<%# Hreflang tags for language variants %>
<% content_for :hreflang do %>
  <!-- Original article -->
  <link rel="alternate" hreflang="<%= @primary_language.html_lang %>" href="<%= public_article_url(@article.slug) %>" data-turbo-track="reload">

  <!-- Article variants -->
  <% @available_variants.each do |variant| %>
    <link rel="alternate" hreflang="<%= variant.language.html_lang %>" href="<%= localized_public_article_url(variant.language.html_lang, @article.slug) %>" data-turbo-track="reload">
  <% end %>

  <!-- x-default -->
  <link rel="alternate" hreflang="x-default" href="<%= public_article_url(@article.slug) %>" data-turbo-track="reload">
<% end %>
