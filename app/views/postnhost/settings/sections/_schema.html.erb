        <div class="mb-6">
          <h2 class="text-xl font-medium tracking-tight text-gray-700">Schema</h2>
          <p class="mt-1 text-sm text-gray-500">Configure WebSite, Organization, and default Article schema values.</p>
        </div>

        <div class="mb-6">
          <% if @schema_locale_keys.any? %>
            <%= form_with url: edit_settings_path, method: :get, class: "space-y-2" do %>
              <%= hidden_field_tag :section, 'schema' %>
              <label for="schema-locale-selector" class="<%= form_label_classes %>">Language</label>
              <%= select_tag :locale,
                options_for_select(@schema_locale_keys, @schema_selected_locale_key),
                id: "schema-locale-selector",
                class: form_input_classes,
                onchange: "this.form.requestSubmit()" %>
            <% end %>
            <p class="mt-2 text-xs text-gray-500">Leave localized fields blank to inherit from default language (<%= @schema_default_locale_key %>).</p>
          <% end %>
        </div>

        <%= form_with url: settings_path(section: 'schema'), method: :patch, class: "space-y-6" do %>
          <%= render 'postnhost/shared/form_errors', resource: @setting %>
          <%= hidden_field_tag :locale_key, @schema_selected_locale_key %>

          <div class="rounded-xl border border-gray-200 p-4 space-y-4">
            <h3 class="text-base font-medium text-gray-900">WebSite</h3>

            <div class="space-y-2">
              <label for="schema_translation_website_name" class="<%= form_label_classes %>">name</label>
              <%= text_field_tag "schema_translations[website_name]",
                @schema_translation_entries["website_name"],
                id: "schema_translation_website_name",
                class: form_input_classes,
                placeholder: "Name of the site or publication" %>
            </div>

            <div class="space-y-2">
              <label for="schema_translation_website_description" class="<%= form_label_classes %>">description</label>
              <%= text_area_tag "schema_translations[website_description]",
                @schema_translation_entries["website_description"],
                id: "schema_translation_website_description",
                rows: 3,
                class: form_textarea_classes,
                placeholder: "Description under 250 characters." %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="schema_derived_website_in_language" class="<%= form_label_classes %>">inLanguage</label>
                <%= text_field_tag "schema_derived_website_in_language",
                  @schema_selected_locale_key,
                  id: "schema_derived_website_in_language",
                  class: "w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm disabled:bg-gray-100",
                  readonly: true,
                  disabled: true %>
              </div>

              <div class="space-y-2">
                <label for="schema_derived_website_publisher_id" class="<%= form_label_classes %>">publisherId</label>
                <%= text_field_tag "schema_derived_website_publisher_id",
                  "#{postnhost.root_url.to_s.chomp('/')}/#organization",
                  id: "schema_derived_website_publisher_id",
                  class: "w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm disabled:bg-gray-100",
                  readonly: true,
                  disabled: true %>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-gray-200 p-4 space-y-4">
            <h3 class="text-base font-medium text-gray-900">Organization</h3>

            <div class="space-y-2">
              <label for="schema_settings_organization_type" class="<%= form_label_classes %>">orgType</label>
              <%= select_tag "schema_settings[organization_type]",
                options_for_select(schema_organization_type_options, @schema_setting_values["organization_type"].presence || "Organization"),
                id: "schema_settings_organization_type",
                class: form_input_classes %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="schema_translation_organization_name" class="<%= form_label_classes %>">name</label>
                <%= text_field_tag "schema_translations[organization_name]",
                  @schema_translation_entries["organization_name"],
                  id: "schema_translation_organization_name",
                  class: form_input_classes,
                  placeholder: "Defaults to publication name." %>
              </div>

              <div class="space-y-2">
                <label for="schema_translation_organization_alternate_name" class="<%= form_label_classes %>">alternateName (Optional)</label>
                <%= text_field_tag "schema_translations[organization_alternate_name]",
                  @schema_translation_entries["organization_alternate_name"],
                  id: "schema_translation_organization_alternate_name",
                  class: form_input_classes,
                  placeholder: "Abbreviation or alternative brand name." %>
              </div>
            </div>

            <div class="space-y-2">
              <label for="schema_translation_organization_description" class="<%= form_label_classes %>">description</label>
              <%= text_area_tag "schema_translations[organization_description]",
                @schema_translation_entries["organization_description"],
                id: "schema_translation_organization_description",
                rows: 3,
                class: form_textarea_classes,
                placeholder: "Defaults to site description." %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="schema_settings_founding_date" class="<%= form_label_classes %>">foundingDate (Optional)</label>
                <%= date_field_tag "schema_settings[founding_date]",
                  @schema_setting_values["founding_date"],
                  id: "schema_settings_founding_date",
                  class: form_input_classes %>
              </div>

              <div class="space-y-2">
                <label for="schema_settings_founding_location" class="<%= form_label_classes %>">foundingLocation (Optional)</label>
                <%= text_field_tag "schema_settings[founding_location]",
                  @schema_setting_values["founding_location"],
                  id: "schema_settings_founding_location",
                  class: form_input_classes,
                  placeholder: "City, Country" %>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="schema_settings_contact_email" class="<%= form_label_classes %>">contactEmail (Optional)</label>
                <%= email_field_tag "schema_settings[contact_email]",
                  @schema_setting_values["contact_email"],
                  id: "schema_settings_contact_email",
                  class: form_input_classes,
                  placeholder: "contact@example.com" %>
              </div>

              <div class="space-y-2">
                <label for="schema_settings_contact_type" class="<%= form_label_classes %>">contactType (Optional)</label>
                <%= select_tag "schema_settings[contact_type]",
                  options_for_select(schema_contact_type_options, @schema_setting_values["contact_type"]),
                  include_blank: "Select contact type",
                  id: "schema_settings_contact_type",
                  class: form_input_classes %>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="space-y-2 md:col-span-2">
                <label for="schema_settings_address" class="<%= form_label_classes %>">address (Optional)</label>
                <%= text_field_tag "schema_settings[address]",
                  @schema_setting_values["address"],
                  id: "schema_settings_address",
                  class: form_input_classes %>
              </div>

              <div class="space-y-2">
                <label for="schema_settings_address_city" class="<%= form_label_classes %>">addressCity (Optional)</label>
                <%= text_field_tag "schema_settings[address_city]",
                  @schema_setting_values["address_city"],
                  id: "schema_settings_address_city",
                  class: form_input_classes %>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="schema_settings_address_country" class="<%= form_label_classes %>">addressCountry (Optional)</label>
                <%= text_field_tag "schema_settings[address_country]",
                  @schema_setting_values["address_country"],
                  id: "schema_settings_address_country",
                  class: form_input_classes,
                  placeholder: "US, GB, etc." %>
              </div>

              <div class="space-y-2">
                <label for="schema_settings_same_as" class="<%= form_label_classes %>">sameAs (Optional, one URL per line)</label>
                <%= text_area_tag "schema_settings[same_as]",
                  schema_array_to_multiline(@schema_setting_values["same_as"]),
                  id: "schema_settings_same_as",
                  rows: 3,
                  class: form_textarea_classes,
                  placeholder: "https://twitter.com/...\nhttps://linkedin.com/..." %>
              </div>
            </div>

            <div class="space-y-2">
              <label for="schema_derived_organization_logo_url" class="<%= form_label_classes %>">logoUrl</label>
              <%= text_field_tag "schema_derived_organization_logo_url",
                setting_site_logo_absolute_url,
                id: "schema_derived_organization_logo_url",
                class: "w-full px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent text-sm disabled:bg-gray-100",
                readonly: true,
                disabled: true %>
              <p class="text-xs text-gray-500">Update this value from Settings -> Assets -> Site Logo.</p>
            </div>
          </div>

          <div class="rounded-xl border border-gray-200 p-4 space-y-4">
            <h3 class="text-base font-medium text-gray-900">Article Defaults</h3>

            <div class="space-y-2">
              <label for="schema_settings_default_article_type" class="<%= form_label_classes %>">articleType (default)</label>
              <%= select_tag "schema_settings[default_article_type]",
                options_for_select(schema_article_type_options, @schema_setting_values["default_article_type"].presence || "BlogPosting"),
                id: "schema_settings_default_article_type",
                class: form_input_classes %>
              <p class="text-xs text-gray-500">Each article can override this type from the article editor sidebar.</p>
            </div>
          </div>

          <details class="group rounded-xl border border-gray-200 p-4">
            <summary class="cursor-pointer list-none flex items-center justify-between">
              <span class="text-base font-medium text-gray-900">Policies</span>
              <%= icon("chevron-down", css_class: "w-4 h-4 text-gray-400 transition-transform duration-200 group-open:rotate-180") %>
            </summary>
            <div class="mt-4 space-y-4">
              <% schema_policy_fields.each do |key, label| %>
                <div class="space-y-2">
                  <label for="schema_settings_policy_<%= key %>" class="<%= form_label_classes %>"><%= label %> (Optional)</label>
                  <%= url_field_tag "schema_settings[policies][#{key}]",
                    @schema_setting_values.dig("policies", key),
                    id: "schema_settings_policy_#{key}",
                    class: form_input_classes,
                    placeholder: "https://example.com/policy" %>
                </div>
              <% end %>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-2">
                  <label for="schema_settings_coverage_starts_at" class="<%= form_label_classes %>">coverageStartsAt (Optional)</label>
                  <%= text_field_tag "schema_settings[coverage_starts_at]",
                    @schema_setting_values["coverage_starts_at"],
                    id: "schema_settings_coverage_starts_at",
                    class: form_input_classes,
                    placeholder: "Optional date or date-time" %>
                </div>
                <div class="space-y-2">
                  <label for="schema_settings_coverage_ends_at" class="<%= form_label_classes %>">coverageEndsAt (Optional)</label>
                  <%= text_field_tag "schema_settings[coverage_ends_at]",
                    @schema_setting_values["coverage_ends_at"],
                    id: "schema_settings_coverage_ends_at",
                    class: form_input_classes,
                    placeholder: "Optional date or date-time" %>
                </div>
              </div>
            </div>
          </details>

          <%= submit_tag 'Save Schema', class: button_classes %>
        <% end %>