<% content_for :title, "Pages" %>

<div class="space-y-8">
  <%= render 'postnhost/shared/elements/page_header',
    title: 'Pages',
    description: 'Manage pages and review code-defined static pages.' do %>
    <%= render 'postnhost/shared/elements/button_link',
      text: 'New Page',
      url: new_page_path,
      icon: 'plus',
      data: { turbo_prefetch: false },
      extra_class: 'w-full md:w-auto' %>
  <% end %>

  <% if @pages.any? %>
    <%= render 'postnhost/shared/elements/table_container',
      headers: [
        { text: 'Page', class: 'col-span-6 md:col-span-5' },
        { text: 'Path', class: 'col-span-6 md:col-span-3' },
        { text: 'Status', class: 'hidden md:block col-span-2' },
        { text: 'Actions', class: 'hidden md:block col-span-2 text-right' },
      ] do %>
      <% @pages.each do |page| %>
        <div class="<%= table_row_classes %>">
          <div class="grid grid-cols-12 gap-4 items-center">
            <div class="col-span-6 md:col-span-5">
              <%= link_to edit_page_path(page), class: "block group" do %>
                <div class="font-medium text-gray-900 group-hover:text-gray-600 transition-colors">
                  <%= page.title.presence || "Untitled Page" %>
                </div>
              <% end %>
            </div>

            <div class="col-span-6 md:col-span-3">
              <% if page.slug.present? %>
                <code class="text-sm text-gray-700">/<%= page.slug %></code>
              <% end %>
            </div>

            <div class="hidden md:flex col-span-2 items-center space-x-2">
              <span class="<%= stats_badge_classes(variant: page.published? ? :green : :gray) %>">
                <%= page.published? ? 'Published' : 'Draft' %>
              </span>
            </div>

            <div class="hidden md:flex col-span-2 items-center justify-end space-x-2">
              <%= render 'postnhost/shared/elements/icon_button',
                icon: 'edit',
                url: edit_page_path(page) %>

              <%= render 'postnhost/shared/elements/icon_button',
                icon: 'trash',
                url: page_path(page),
                variant: :danger,
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this page? This action cannot be undone."
                } %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <%= render 'postnhost/shared/elements/empty_state',
      icon: 'layers',
      title: 'No pages',
      description: 'Create your first custom page.' do %>
      <%= render 'postnhost/shared/elements/button_link',
        text: 'New Page',
        url: new_page_path,
        data: { turbo_prefetch: false },
        icon: 'plus' %>
    <% end %>
  <% end %>

  <% if @static_page_slugs.any? %>
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-gray-900">Code-defined static pages</h2>
      <%= render 'postnhost/shared/elements/table_container',
        headers: [
          { text: 'Static Page', class: 'col-span-6' },
          { text: 'Path', class: 'col-span-6 text-right' }
        ] do %>
        <% @static_page_slugs.each do |slug| %>
          <div class="<%= table_row_classes %>">
            <div class="grid grid-cols-12 gap-4 items-center">
              <div class="min-w-0 col-span-6">
                <div class="font-medium text-gray-900 break-words"><%= slug.humanize %></div>
                <div class="text-sm text-gray-500 mt-1 break-all"><%= slug %>.html.erb</div>
              </div>

              <div class="min-w-0 col-span-6 text-right">
                <code class="text-sm text-gray-700 whitespace-normal break-all inline-block">/<%= slug %></code>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
        These templates are defined in <code>app/views/postnhost/static_pages</code> and are not editable in the admin panel.
      </div>
    </div>
  <% else %>
    <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
      No code-defined static pages found. Add templates in <code>app/views/postnhost/static_pages</code> (for example, <code>about.html.erb</code> maps to <code>/about</code>), or run <code>bin/rails g postnhost:static_pages about</code> to scaffold a starter template.
    </div>
  <% end %>
</div>
