<% content_for :title, "Languages" %>

<div class="space-y-8">
  <%= render 'postnhost/shared/elements/page_header',
    title: 'Languages',
    description: 'Manage your supported languages for articles and categories' do %>
    <%= render 'postnhost/shared/elements/button_link',
      text: 'New Language',
      url: new_language_path,
      icon: 'plus',
      extra_class: 'w-full md:w-auto' %>
  <% end %>

  <% if @languages.any? %>
    <%= render 'postnhost/shared/elements/table_container',
      headers: [
        { text: 'Language', class: 'col-span-5' },
        { text: 'Articles', class: 'col-span-3' },
        { text: 'Actions', class: 'col-span-4 text-right' }
      ] do %>
      <% @languages.each do |language| %>
        <div class="<%= table_row_classes %>">
          <div class="grid grid-cols-12 gap-4 items-center">
            <div class="col-span-5">
              <%= link_to language_path(language), class: "block group" do %>
                <div class="flex items-center space-x-3">
                  <div class="font-medium text-gray-900 group-hover:text-gray-600 transition-colors">
                    <%= language.name %>
                  </div>
                  <% if language.default? %>
                    <span class="<%= stats_badge_classes(variant: :blue) %> px-2 py-1">
                      Default
                    </span>
                  <% end %>
                </div>
                <div class="text-sm text-gray-500 mt-1">
                  Code: <%= language.html_lang %>
                </div>
              <% end %>
            </div>

            <div class="col-span-3">
              <div class="flex items-center space-x-3">
                <span class="<%= stats_badge_classes(variant: :blue) %>">
                  <%= language.articles_count %>
                </span>
                <span class="<%= stats_badge_classes(variant: :purple) %>">
                  <%= language.article_variants_count %>
                </span>
              </div>
            </div>

            <div class="col-span-4 flex items-center justify-end space-x-2">
              <%= render 'postnhost/shared/elements/icon_button',
                icon: 'eye',
                url: language_path(language) %>

              <%= render 'postnhost/shared/elements/icon_button',
                icon: 'edit',
                url: edit_language_path(language) %>

              <%= render 'postnhost/shared/elements/icon_button',
                icon: 'trash',
                url: language_path(language),
                variant: :danger,
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this language? This action cannot be undone."
                } %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <%= render 'postnhost/shared/elements/empty_state',
      icon: 'translate',
      title: 'No languages',
      description: 'Get started by creating your first language.' do %>
      <%= render 'postnhost/shared/elements/button_link',
        text: 'New Language',
        url: new_language_path,
        icon: 'plus' %>
    <% end %>
  <% end %>
</div>
